BEGIN:VEVENT
SUMMARY:Agility - Competition Level 2 (Beth Martin)
DTSTART;TZID=UTC;VALUE=DATE-TIME:20261006T203000Z
DTEND;TZID=UTC;VALUE=DATE-TIME:20261006T213000Z
DTSTAMP;VALUE=DATE-TIME:20261004T200357Z
UID:1791318600_Agility-CompetitionLevel2@luckydog
